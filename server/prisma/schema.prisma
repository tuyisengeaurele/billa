generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  INVOICE
  PROFORMA
  DELIVERY_NOTE
  QUOTE
  RECEIPT
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  FINALIZED
}

enum DocumentTemplate {
  MINIMAL
  PREMIUM
  CLASSIC
}

// Kinyarwanda deferred until its business/financial terminology can be
// verified with a native speaker rather than guessed on a live invoice.
enum DocumentLanguage {
  EN
  FR
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DiscountType {
  PERCENT
  FLAT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum ActivityAction {
  DOCUMENT_CREATED
  DOCUMENT_FINALIZED
  DOCUMENT_DELETED
  DOCUMENT_SHARED
  DOCUMENT_LINK_DISABLED
  DOCUMENT_LINK_ENABLED
  CUSTOMER_CREATED
  CUSTOMER_DEACTIVATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_IMPERSONATION_STARTED
  MEMBER_IMPERSONATION_ENDED
  MEMBER_IMPERSONATION_ENDED_BY_TARGET
}

enum ImpersonationRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  OVERRIDDEN
}

enum NotificationType {
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  MEMBER_JOINED
  CONTACT_MESSAGE_RECEIVED
  DOCUMENT_ACCEPTED
  DOCUMENT_DECLINED
  DOCUMENT_VIEWED
}

model Business {
  id                    String           @id @default(cuid())
  ownerId               String
  name                  String
  tin                   String?
  industry              String?
  phone                 String?
  email                 String?
  address               String?
  logoUrl               String?
  primaryColor          String?
  accentColors          Json?
  rraEbmNumber          String?
  bankName              String?
  bankAccountNumber     String?
  signatoryName         String?
  signatoryTitle        String?
  signatureUrl          String?
  remindersEnabled      Boolean          @default(true)
  reminderCadenceDays   Int              @default(7)
  // A friendly nudge this many days before a payment falls due. 0 turns it off.
  dueSoonReminderDays   Int              @default(3)
  requireApprovalToFinalize Boolean      @default(false)
  defaultTemplate       DocumentTemplate @default(MINIMAL)
  onboardingCompletedAt DateTime?

  momoEnabled            Boolean  @default(false)
  momoEnvironment        String?
  momoTargetEnvironment  String?
  momoSubscriptionKeyEnc String?
  momoApiUserEnc         String?
  momoApiKeyEnc          String?

  lastDigestSentAt      DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  owner                 User                   @relation(fields: [ownerId], references: [id])
  customers             Customer[]
  items                 Item[]
  documents             Document[]
  sequences             DocumentSequence[]
  members               BusinessMember[]
  invites               BusinessInvite[]
  activityLog           ActivityLogEntry[]
  invoicePayments       InvoicePayment[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  impersonationRequests ImpersonationRequest[]
  momoPaymentRequests    MomoPaymentRequest[]

  @@index([ownerId])
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  firebaseUid             String            @unique
  name                    String?
  phone                   String?
  avatarUrl               String?
  notificationPreferences Json?
  productTourSeenAt       DateTime?
  trialEndsAt             DateTime
  currentPeriodEnd        DateTime?
  plan                    SubscriptionPlan?
  lastActiveBusinessId    String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])

  isAdmin     Boolean   @default(false)
  suspendedAt DateTime?

  businesses                 Business[]
  refreshTokens              RefreshToken[]
  payments                   Payment[]
  twoFactorChallenges        TwoFactorChallenge[]
  memberships                BusinessMember[]
  activityLog                ActivityLogEntry[]
  adminAuditLog              AdminAuditLogEntry[]
  announcements              Announcement[]
  invoicePaymentsCreated     InvoicePayment[]
  impersonationRequestsMade  ImpersonationRequest[] @relation("ImpersonationRequester")
  impersonationRequestsForMe ImpersonationRequest[] @relation("ImpersonationTarget")
  notifications              Notification[]
}

// A business has its owner plus members, and every member can read and write. The enum
// stays (with one value) so the column and the API's role field keep working unchanged.
enum BusinessMemberRole {
  MEMBER
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(MEMBER)
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessInvite {
  id         String             @id @default(cuid())
  businessId String
  email      String
  role       BusinessMemberRole @default(MEMBER)
  token      String             @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([email])
}

model ActivityLogEntry {
  id          String         @id @default(cuid())
  businessId  String
  actorUserId String
  action      ActivityAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id])
  actor    User     @relation(fields: [actorUserId], references: [id])

  @@index([businessId, createdAt])
  @@index([actorUserId])
}

model AdminAuditLogEntry {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([createdAt])
  @@index([adminUserId])
}

model JobRunLog {
  id           String   @id @default(cuid())
  jobName      String
  ranAt        DateTime @default(now())
  succeeded    Boolean
  resultCount  Int?
  errorMessage String?

  @@index([jobName, ranAt])
}

model EmailSendLog {
  id     String   @id @default(cuid())
  sentAt DateTime @default(now())

  @@index([sentAt])
}

model Announcement {
  id          String   @id @default(cuid())
  message     String
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([active])
}

model TwoFactorChallenge {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ImpersonationRequest {
  id             String                     @id @default(cuid())
  requesterId    String
  targetUserId   String
  businessId     String
  reason         String?
  status         ImpersonationRequestStatus @default(PENDING)
  requestedAt    DateTime                   @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime
  redeemedAt     DateTime?
  overrideReason String?

  requester User     @relation("ImpersonationRequester", fields: [requesterId], references: [id])
  target    User     @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  business  Business @relation(fields: [businessId], references: [id])

  @@index([targetUserId, status])
  @@index([requesterId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model ApiKey {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  // The first characters of the key, kept so a person can tell keys apart in the list.
  // The key itself is never stored, only its SHA-256 hash.
  keyPrefix       String
  keyHash         String    @unique
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  businessId String
  url        String
  // Encrypted with WEBHOOK_SECRET_ENCRYPTION_KEY; the raw secret is shown once, on creation.
  secretEnc  String
  events     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business   Business          @relation(fields: [businessId], references: [id])
  deliveries WebhookDelivery[]

  @@index([businessId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  businessId     String
  tokenHash      String
  family         String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  // Set only on a session issued by impersonation (see session.ts's
  // issueSession) - userId here is the *target's* id even for that session,
  // so a live, unrevoked row with this set is exactly "someone is currently
  // impersonating this user", queryable from the target's own separate
  // session. Must be carried across /auth/refresh's token rotation or an
  // impersonation session would silently stop looking like one after the
  // access token's first 15-minute expiry.
  impersonatedBy String?

  // One device holds one live session. deviceId comes from a long-lived cookie on that browser (or app);
  // signing in again there replaces the session instead of adding one.
  deviceId   String?
  deviceName String?
  // Bumped each time the session is renewed, so the list can say when a device was last active.
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  tin         String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  // Whole RWF. Only used to warn when a new invoice would take what they owe past it.
  creditLimit Int?
  portalToken String   @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  documents Document[]

  @@index([businessId])
}

model Item {
  id          String   @id @default(cuid())
  businessId  String
  description String
  unitPrice   Int
  unit        String
  taxRate     Decimal  @default(18) @db.Decimal(5, 2)
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id])
  lines    DocumentLine[]

  @@index([businessId])
}

model DocumentSequence {
  id            String       @id @default(cuid())
  businessId    String
  type          DocumentType
  prefix        String
  nextNumber    Int          @default(1)
  resetYearly   Boolean      @default(false)
  lastResetYear Int?

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, type])
}

model Document {
  id                String           @id @default(cuid())
  businessId        String
  type              DocumentType
  number            String?
  status            DocumentStatus   @default(DRAFT)
  template          DocumentTemplate
  language          DocumentLanguage @default(EN)
  customerId        String
  issueDate         DateTime         @default(now())
  dueDate           DateTime?
  notes             String?
  customerReference String?
  subtotal          Int
  taxTotal          Int
  total             Int
  // Amounts are whole numbers of the currency's smallest unit (RWF has none, USD counts cents).
  currency          String           @default("RWF")
  // RWF for one whole unit of the currency, saved with the document for reports. Empty for RWF.
  exchangeRate      Float?
  sentAt           DateTime?
  firstViewedAt     DateTime?
  lastViewedAt      DateTime?
  viewCount         Int              @default(0)

  publicToken String @unique @default(dbgenerated("gen_random_uuid()::text"))
  // Set while the public link is switched off: the page, PDF and payment request for this token all answer "not found".
  publicLinkDisabledAt DateTime?

  recurrenceInterval RecurrenceInterval?
  recurrenceEndDate  DateTime?
  nextRecurrenceAt   DateTime?

  lastReminderSentAt   DateTime?
  // The due date the "due soon" nudge was last sent for, so each payment gets one, instalments included.
  dueSoonReminderFor   DateTime?
  expiryReminderSentAt DateTime?
  remindersEnabled     Boolean   @default(true)

  convertedFromId String?   @unique
  convertedFrom   Document? @relation("DocumentConversion", fields: [convertedFromId], references: [id])
  convertedTo     Document? @relation("DocumentConversion")
  declinedAt      DateTime?

  referencedDocumentId String?
  referencedDocument   Document?  @relation("DocumentReference", fields: [referencedDocumentId], references: [id])
  referencingDocuments Document[] @relation("DocumentReference")

  amountPaid     Int                   @default(0)
  paymentStatus  InvoicePaymentStatus?
  writtenOffAt   DateTime?
  writeOffReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business         @relation(fields: [businessId], references: [id])
  customer          Customer         @relation(fields: [customerId], references: [id])
  lines             DocumentLine[]
  installments      DocumentInstalment[]
  attachments       DocumentAttachment[]
  payments          InvoicePayment[] @relation("DocumentPayments")
  paymentReceiptFor InvoicePayment?  @relation("PaymentReceipt")
  momoPaymentRequests MomoPaymentRequest[]

  @@unique([businessId, type, number])
  @@index([businessId])
  @@index([customerId])
  @@index([nextRecurrenceAt])
  @@index([referencedDocumentId])
}

model DocumentLine {
  id            String        @id @default(cuid())
  documentId    String
  itemId        String?
  description   String
  quantity      Decimal       @db.Decimal(10, 2)
  unitPrice     Int
  taxRate       Decimal       @db.Decimal(5, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  lineTotal     Int
  sortOrder     Int

  document Document @relation(fields: [documentId], references: [id])
  item     Item?    @relation(fields: [itemId], references: [id])

  @@index([documentId])
}

// One step of a payment plan on an invoice: an amount and the date it falls due. Whether a step has
// been paid is never stored; it is worked out from the payments recorded against the invoice.
model DocumentInstalment {
  id         String   @id @default(cuid())
  documentId String
  sortOrder  Int
  label      String?
  amount     Int
  dueDate    DateTime

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// A file kept with a document: a purchase order, a signed quote, proof of delivery. Never printed on the PDF.
model DocumentAttachment {
  id           String   @id @default(cuid())
  documentId   String
  businessId   String
  fileName     String
  url          String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// The bank's reference rate for each foreign currency, RWF for one whole unit, refreshed daily.
model ExchangeRate {
  currency  String   @id
  rate      Float
  // The day the bank published this rate for.
  rateDate  DateTime
  source    String
  fetchedAt DateTime

  @@map("ExchangeRate")
}

model InvoicePayment {
  id         String        @id @default(cuid())
  businessId String
  documentId String
  amount     Int
  method     PaymentMethod
  paidOn     DateTime
  notes      String?
  referenceNumber String?
  payerName       String?
  receiptImageUrl String?

  receiptDocumentId String? @unique

  momoPaymentRequestId String?             @unique
  momoPaymentRequest   MomoPaymentRequest? @relation("MomoRequestPayment", fields: [momoPaymentRequestId], references: [id])

  voidedAt   DateTime?
  voidReason String?

  createdAt       DateTime @default(now())
  createdByUserId String

  business        Business  @relation(fields: [businessId], references: [id])
  document        Document  @relation("DocumentPayments", fields: [documentId], references: [id])
  receiptDocument Document? @relation("PaymentReceipt", fields: [receiptDocumentId], references: [id])
  createdBy       User      @relation(fields: [createdByUserId], references: [id])

  @@index([businessId, documentId])
}

enum MomoRequestStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

model MomoPaymentRequest {
  id            String            @id @default(cuid())
  businessId    String
  documentId    String
  referenceId   String            @unique
  phoneNumber   String
  amount        Int
  status        MomoRequestStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  invoicePayment InvoicePayment? @relation("MomoRequestPayment")

  @@index([businessId])
  @@index([documentId])
  @@index([status])
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

model Payment {
  id            String           @id @default(cuid())
  userId        String
  plan          SubscriptionPlan
  amount        Int
  currency      String
  txRef         String           @unique
  phoneNumber   String
  status        PaymentStatus    @default(PENDING)
  failureReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ContactMessage {
  id           String    @id @default(cuid())
  name         String
  email        String
  message      String
  createdAt    DateTime  @default(now())
  repliedAt    DateTime?
  replyMessage String?
}
