generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  INVOICE
  PROFORMA
  DELIVERY_NOTE
  QUOTE
  RECEIPT
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  FINALIZED
}

enum DocumentTemplate {
  MINIMAL
  PREMIUM
  CLASSIC
}

// Kinyarwanda deferred until its business/financial terminology can be
// verified with a native speaker rather than guessed on a live invoice.
enum DocumentLanguage {
  EN
  FR
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DiscountType {
  PERCENT
  FLAT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum ActivityAction {
  DOCUMENT_CREATED
  DOCUMENT_FINALIZED
  DOCUMENT_DELETED
  CUSTOMER_CREATED
  CUSTOMER_DEACTIVATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_IMPERSONATION_STARTED
  MEMBER_IMPERSONATION_ENDED
}

enum ImpersonationRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  OVERRIDDEN
}

enum NotificationType {
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  MEMBER_JOINED
  CONTACT_MESSAGE_RECEIVED
}

model Business {
  id                    String           @id @default(cuid())
  ownerId               String
  name                  String
  tin                   String?
  industry              String?
  phone                 String?
  email                 String?
  address               String?
  logoUrl               String?
  primaryColor          String?
  accentColors          Json?
  rraEbmNumber          String?
  bankName              String?
  bankAccountNumber     String?
  signatoryName         String?
  signatoryTitle        String?
  signatureUrl          String?
  remindersEnabled      Boolean          @default(true)
  reminderCadenceDays   Int              @default(7)
  defaultTemplate       DocumentTemplate @default(MINIMAL)
  onboardingCompletedAt DateTime?
  lastDigestSentAt      DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  owner                 User                   @relation(fields: [ownerId], references: [id])
  customers             Customer[]
  items                 Item[]
  documents             Document[]
  sequences             DocumentSequence[]
  members               BusinessMember[]
  invites               BusinessInvite[]
  activityLog           ActivityLogEntry[]
  invoicePayments       InvoicePayment[]
  impersonationRequests ImpersonationRequest[]

  @@index([ownerId])
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  firebaseUid          String            @unique
  name                 String?
  avatarUrl            String?
  productTourSeenAt    DateTime?
  trialEndsAt          DateTime
  currentPeriodEnd     DateTime?
  plan                 SubscriptionPlan?
  lastActiveBusinessId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])

  isAdmin     Boolean   @default(false)
  suspendedAt DateTime?

  businesses                 Business[]
  refreshTokens              RefreshToken[]
  payments                   Payment[]
  twoFactorChallenges        TwoFactorChallenge[]
  memberships                BusinessMember[]
  activityLog                ActivityLogEntry[]
  adminAuditLog              AdminAuditLogEntry[]
  announcements              Announcement[]
  invoicePaymentsCreated     InvoicePayment[]
  impersonationRequestsMade  ImpersonationRequest[] @relation("ImpersonationRequester")
  impersonationRequestsForMe ImpersonationRequest[] @relation("ImpersonationTarget")
  notifications              Notification[]
}

// ACCOUNTANT is read-only: blocked from every mutating request on business
// data (see blockAccountantMutations), regardless of which route it comes
// through. MEMBER keeps today's full read/write behavior.
enum BusinessMemberRole {
  MEMBER
  ACCOUNTANT
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(MEMBER)
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessInvite {
  id         String             @id @default(cuid())
  businessId String
  email      String
  role       BusinessMemberRole @default(MEMBER)
  token      String             @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([email])
}

model ActivityLogEntry {
  id          String         @id @default(cuid())
  businessId  String
  actorUserId String
  action      ActivityAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id])
  actor    User     @relation(fields: [actorUserId], references: [id])

  @@index([businessId, createdAt])
  @@index([actorUserId])
}

model AdminAuditLogEntry {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([createdAt])
  @@index([adminUserId])
}

model JobRunLog {
  id           String   @id @default(cuid())
  jobName      String
  ranAt        DateTime @default(now())
  succeeded    Boolean
  resultCount  Int?
  errorMessage String?

  @@index([jobName, ranAt])
}

model Announcement {
  id          String   @id @default(cuid())
  message     String
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([active])
}

model TwoFactorChallenge {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ImpersonationRequest {
  id             String                     @id @default(cuid())
  requesterId    String
  targetUserId   String
  businessId     String
  reason         String?
  status         ImpersonationRequestStatus @default(PENDING)
  requestedAt    DateTime                   @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime
  redeemedAt     DateTime?
  overrideReason String?

  requester User     @relation("ImpersonationRequester", fields: [requesterId], references: [id])
  target    User     @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  business  Business @relation(fields: [businessId], references: [id])

  @@index([targetUserId, status])
  @@index([requesterId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  tokenHash  String
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  tin         String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  portalToken String   @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  documents Document[]

  @@index([businessId])
}

model Item {
  id          String   @id @default(cuid())
  businessId  String
  description String
  unitPrice   Int
  unit        String
  taxRate     Decimal  @default(18) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id])
  lines    DocumentLine[]

  @@index([businessId])
}

model DocumentSequence {
  id         String       @id @default(cuid())
  businessId String
  type       DocumentType
  prefix     String
  nextNumber Int          @default(1)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, type])
}

model Document {
  id                String           @id @default(cuid())
  businessId        String
  type              DocumentType
  number            String?
  status            DocumentStatus   @default(DRAFT)
  template          DocumentTemplate
  language          DocumentLanguage @default(EN)
  customerId        String
  issueDate         DateTime         @default(now())
  dueDate           DateTime?
  notes             String?
  customerReference String?
  subtotal          Int
  taxTotal          Int
  total             Int
  sentAt            DateTime?

  publicToken String @unique @default(dbgenerated("gen_random_uuid()::text"))

  recurrenceInterval RecurrenceInterval?
  recurrenceEndDate  DateTime?
  nextRecurrenceAt   DateTime?

  lastReminderSentAt DateTime?

  convertedFromId String?   @unique
  convertedFrom   Document? @relation("DocumentConversion", fields: [convertedFromId], references: [id])
  convertedTo     Document? @relation("DocumentConversion")
  declinedAt      DateTime?

  referencedDocumentId String?
  referencedDocument   Document?  @relation("DocumentReference", fields: [referencedDocumentId], references: [id])
  referencingDocuments Document[] @relation("DocumentReference")

  amountPaid     Int                   @default(0)
  paymentStatus  InvoicePaymentStatus?
  writtenOffAt   DateTime?
  writeOffReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business         @relation(fields: [businessId], references: [id])
  customer          Customer         @relation(fields: [customerId], references: [id])
  lines             DocumentLine[]
  payments          InvoicePayment[] @relation("DocumentPayments")
  paymentReceiptFor InvoicePayment?  @relation("PaymentReceipt")

  @@unique([businessId, type, number])
  @@index([businessId])
  @@index([nextRecurrenceAt])
  @@index([referencedDocumentId])
}

model DocumentLine {
  id            String        @id @default(cuid())
  documentId    String
  itemId        String?
  description   String
  quantity      Decimal       @db.Decimal(10, 2)
  unitPrice     Int
  taxRate       Decimal       @db.Decimal(5, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  lineTotal     Int
  sortOrder     Int

  document Document @relation(fields: [documentId], references: [id])
  item     Item?    @relation(fields: [itemId], references: [id])

  @@index([documentId])
}

model InvoicePayment {
  id         String        @id @default(cuid())
  businessId String
  documentId String
  amount     Int
  method     PaymentMethod
  paidOn     DateTime
  notes      String?
  referenceNumber String?
  payerName       String?
  receiptImageUrl String?

  receiptDocumentId String? @unique

  voidedAt   DateTime?
  voidReason String?

  createdAt       DateTime @default(now())
  createdByUserId String

  business        Business  @relation(fields: [businessId], references: [id])
  document        Document  @relation("DocumentPayments", fields: [documentId], references: [id])
  receiptDocument Document? @relation("PaymentReceipt", fields: [receiptDocumentId], references: [id])
  createdBy       User      @relation(fields: [createdByUserId], references: [id])

  @@index([businessId, documentId])
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model Payment {
  id              String           @id @default(cuid())
  userId          String
  plan            SubscriptionPlan
  amount          Int
  currency        String
  txRef           String           @unique
  flutterwaveTxId String?
  status          PaymentStatus    @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
