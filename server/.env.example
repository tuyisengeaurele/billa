DATABASE_URL="postgresql://user:password@localhost:5432/billa"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# This server's own public URL, used to build absolute links (e.g. logo images in emails).
API_URL="http://localhost:4000"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# local disk adapter for dev; swap for S3-compatible config in prod
UPLOADS_DIR="./uploads"

# Storage backend: "local" (default) or "r2". Set to "r2" in production;
# local disk is wiped on redeploy on Railway/Render/Fly.
STORAGE_DRIVER="local"
# Cloudflare R2 (Dashboard -> R2 -> Manage API Tokens for the access key pair;
# create the bucket first and put its name below)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="billa-uploads"
# Optional: the bucket's public URL (Bucket -> Settings -> Public access -> Allow Access
# via R2.dev subdomain, or a custom domain). Needed so uploaded logos load in emails,
# since mail providers fetch images from their own servers and can't reach API_URL
# until this API is deployed publicly. Leave unset until you've enabled that.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Firebase Admin SDK (Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# MTN Mobile Money (used to encrypt each business's own MoMo credentials at rest).
# Generate one with: openssl rand -base64 32
MOMO_CREDENTIALS_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# Encrypts each user's TOTP (2FA) secret at rest. A separate key from the MoMo one
# above, so leaking or rotating one never exposes the other.
# Generate one with: openssl rand -base64 32
TOTP_SECRET_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# Billa's own MTN Mobile Money account (used for subscription billing, NOT the
# per-business credentials businesses enter in their own Business Settings).
MOMO_BILLING_SUBSCRIPTION_KEY="your-subscription-key"
MOMO_BILLING_API_USER="your-api-user-id"
MOMO_BILLING_API_KEY="your-api-key"
MOMO_BILLING_ENVIRONMENT="sandbox"
# Only required when MOMO_BILLING_ENVIRONMENT is "production".
MOMO_BILLING_TARGET_ENVIRONMENT=""

# Gmail SMTP (transactional email: sending documents, contact replies, notifications)
# GMAIL_APP_PASSWORD is a Google Account app password, not your regular login password.
GMAIL_USER="your-business@gmail.com"
GMAIL_APP_PASSWORD="your16charapppassword"

# Optional: error monitoring. Leave unset locally; set in production once you have a Sentry project.
SENTRY_DSN=""

# Contact form (see server/src/routes/contact.ts)
# Comma-separated list of user emails allowed to view GET /contact (the admin message list)
ADMIN_EMAILS="you@example.com"
# Optional: if set, an email is sent here every time someone submits the contact form
CONTACT_NOTIFICATION_EMAIL="you@example.com"
